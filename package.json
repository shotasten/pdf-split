{
  "name": "pdf-split",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:icons": "node scripts/generate-icons.mjs",
