    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "vitest": "3.2.4"
  }
